# ---------- General ----------
BOT_NAME=Sol
PREFIX=!
# Extra numbers (digits only, with country code) allowed to use owner commands via DM.
# Your own number (the linked account) is ALWAYS owner. Comma-separated.
OWNER_NUMBERS=
# For headless servers: pair with a code instead of a QR. Digits only, e.g. 249912345678
PAIRING_NUMBER=

# ---------- System ----------
# Optional: only show these mount points in !status (comma-separated). Empty = auto.
DISK_MOUNTS=

# ---------- Minecraft ----------
MC_DIR=/home/minecraft/server
MC_HOST=127.0.0.1
MC_PORT=25565
MC_START_CMD=tmux new-session -d -s minecraft "java -Xms1G -Xmx2G -jar server.jar nogui"
MC_STOP_CMD=tmux send-keys -t minecraft stop Enter
# server.properties: enable-rcon=true, rcon.port=25575, rcon.password=...
RCON_PORT=25575
RCON_PASSWORD=change-me

# ---------- Downloader ----------
# Auto-download when you paste a bare link in your self-chat
AUTO_DL=true
# Sent as a normal video up to this size (MB); larger files are sent as documents
DL_VIDEO_MB=60
# Hard cap (MB)
DL_MAX_MB=1500
DL_CONCURRENCY=2
# Optional cookies.txt for yt-dlp (age-gated / private content)
YTDLP_COOKIES=

# ---------- AI ----------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_MEMORY_MODEL=gemini-2.5-flash-lite
AI_HISTORY=24
# Extract long-term facts every N user messages
AI_MEMORY_EVERY=4

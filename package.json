{
  "name": "wabot",
  "version": "1.0.0",
  "description": "WhatsApp server bot: system stats, Minecraft control, video downloads, AI chat with soul & memory",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --experimental-test-module-mocks --test tests/*.test.js",
    "test:python": ".venv-youtube/bin/python -m unittest discover -s tests/python -p 'test_*.py'",
    "test:coverage": "node --experimental-test-module-mocks --experimental-test-coverage --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@whiskeysockets/baileys": "^6.7.18",
    "dotenv": "^16.4.5",
    "minecraft-server-util": "^5.4.0",
    "pino": "^9.0.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "systeminformation": "^5.23.0"
  }
}
